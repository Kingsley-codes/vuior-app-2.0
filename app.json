{
  "expo": {
    "name": "Vuior",
    "slug": "vuior",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/favicon.png",
      "bundleIdentifier": "com.vuior.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.vuior.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/favicon.png",
        "monochromeImage": "./assets/favicon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/favicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#208AEF",
            "image": "./assets/favicon.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          },
          "ios": {
            "backgroundColor": "#208AEF",
            "image": "./assets/favicon.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
